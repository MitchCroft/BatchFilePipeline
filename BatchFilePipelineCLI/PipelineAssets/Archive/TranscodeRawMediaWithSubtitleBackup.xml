<?xml version="1.0" encoding="utf-8"?>
<!--
	Transcode Raw Media With Subtitle Backup

	This pipeline will take a series of video files from a local input directory and process them to apply
	a Handbrake preset over them to reduce their overall size and convert any graphical subtitles into
	text based subtitles. It outputs them into a separate output directory, maintaining the same directory
	structure as the input. It uses a manifest file to track which files have already been processed to
	avoid redundant work. Embeded subtitles will be stripped out of the final video file

	Applications:
	- ffprobe = Read video information to know how to process them
	- ffmpeg = Extract and remux video files
	- SubtitleEdit = Convert graphical subtitles to text based subtitles
	- HandbrakeCLI = CLI Handbrake application that can be used to apply to transcoding preset for size reduction

	Required Inputs:
	- InputDir = Path to the input directory containing video files to be processed
	- OutputDir = Path to the output directory where processed files will be saved
	- SubtitleDir = Path ot the output directory where extracted subtitles will be saved
	- HandbrakeManifestPath = The JSON file describing the different Handbrake Presets that can be applied when processing
	- Dictionary = A plain text file with various words that can be used as a basic evaluation of subtitle conversion success
-->

<Pipeline xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Name="Transcode Raw Media With Subtitle Backup">
	<!-- These are the master settings that will be used to control the pipeline process -->
	<Environment>
		<FFprobe>ffprobe</FFprobe>
		<FFmpeg>ffmpeg</FFmpeg>
		<SubtitleEdit>SubtitleEdit</SubtitleEdit>
		<HandbrakeCLI>HandBrakeCLI</HandbrakeCLI>
		<ExtensionFilter>*.mkv|*.mp4</ExtensionFilter>
		<HardwareAcceleration>False</HardwareAcceleration>
	</Environment>
	<Workflow>
		<!-- There are some common elements that will be shared for all of the files that are processed in the pipeline -->
		<PreProcessGraph>
			<!-- We can read in the manifest of different handbrake preset options from which to choose when transcoding -->
			<Node Name="Read in Handbrake Preset Manifest" ID="PreProcess_00" TypeID="LoadExternalHandbrakePresetsNode">
				<Inputs>
					<ManifestPath>{HandbrakeManifestPath}</ManifestPath>
				</Inputs>
				<Outputs>
					<Output>HandbrakePresetManifest</Output>
				</Outputs>
				<Connections>
					<Default>PreProcess_01</Default>
				</Connections>
			</Node>

			<!-- Select just the presets in the manifest that we can use for processing -->
			<Node Name="Isolate Loaded Handbrake Presets" ID="PreProcess_01" TypeID="ReflectiveSelectNode">
				<Inputs>
					<Source>{HandbrakePresetManifest}</Source>
					<Path>PresetList</Path>
				</Inputs>
				<Outputs>
					<Output>HandbrakePresets</Output>
				</Outputs>
				<Connections>
					<Default>PreProcess_02</Default>
				</Connections>
			</Node>

			<!-- To make this safer to run on back-to-back executions, we're going to use the current timestamp as an additional marker for the working directory -->
			<Node Name="Format Time" ID="PreProcess_02" TypeID="FormatDateTimeNode">
				<Inputs>
					<FormatString>yyyyMMdd_hhmmss</FormatString>
				</Inputs>
				<Outputs>
					<Output>Timestamp</Output>
				</Outputs>
				<Connections>
					<Default>PreProcess_03</Default>
				</Connections>
			</Node>

			<!-- We need to find the path that will be used for the working directory, placed within the output folder -->
			<Node Name="Assemble Working Directory" ID="PreProcess_03" TypeID="CombinePathNode">
				<Inputs>
					<LeftPath>{OutputDir}</LeftPath>
					<RightPath>Working_{Timestamp}</RightPath>
				</Inputs>
				<Outputs>
					<Output>WorkingDir</Output>
				</Outputs>
				<Connections>
					<Default>PreProcess_04</Default>
				</Connections>
			</Node>

			<!-- We want to export that final directory to the rest of the graph for use -->
			<Node Name="Export Established Values" ID="PreProcess_04" TypeID="ExportValuesNode">
				<Inputs>
					<WorkingDir>{WorkingDir}</WorkingDir>
					<HandbrakePresets>{HandbrakePresets}</HandbrakePresets>
				</Inputs>
			</Node>
		</PreProcessGraph>

		<!-- The main graph is going to run through all of the input files and ensure that they have been processed for use -->
		<MainGraph>
			<!-- For the identification, we just need to find the files that are in the input directory -->
			<IdentificationGraph>
				<!-- Locate all of the files of the expected types -->
				<Node Name="Find Video Files" ID="Identification_00" TypeID="FindFilesInDirectoryNode">
					<Inputs>
						<SearchDirectory>{InputDir}</SearchDirectory>
						<SearchPattern>{ExtensionFilter}</SearchPattern>
					</Inputs>
					<Outputs>
						<Output>Files</Output>
					</Outputs>
					<Connections>
						<Default>Identification_01</Default>
					</Connections>
				</Node>

				<!-- Export the collection of files that were identified for use at runtime for processing -->
				<Node Name="Export Found Files" ID="Identification_01" TypeID="ExportValuesNode">
					<Inputs>
						<Identifiers>{Files}</Identifiers>
					</Inputs>
				</Node>
			</IdentificationGraph>

			<!-- Now we can handle the main processing of the file. We will need to chain together the different nodes to receive the final output -->
			<ProcessGraph>
				<!-- Check the manifest to see if this identified file has already been processed before -->
				<Node Name="Check if File has been Processed" ID="Process_00" TypeID="GetManifestDataNode">
					<Inputs>
						<ManifestPath>{OutputDir}\TranscodeRawMediaWithSubBackup_Manifest.json</ManifestPath>
						<Identifier>{CurrentIdentifier}</Identifier>
						<Key>State</Key>
					</Inputs>
					<Outputs>
						<Output>FileState</Output>
					</Outputs>
					<Connections>
						<Default>Process_01</Default>
					</Connections>
				</Node>

				<!-- If the file has already been processed, we can just skip testing this file -->
				<Node Name="Compare Initial State" ID="Process_01" TypeID="ComparisonNode">
					<Inputs>
						<LeftValue>{FileState}</LeftValue>
						<RightValue>Complete</RightValue>
					</Inputs>
					<Connections>
						<!-- True intentionally left blank so that the processing of this file will stop here -->
						<True></True>

						<!-- If the file has not been processed yet, we will need to start processing the information stored in it -->
						<False>Process_02</False>
					</Connections>
				</Node>

				<!-- Get the relative path of the input file that will be processed -->
				<Node Name="Get File Relative Path" ID="Process_02" TypeID="GetRelativePathNode">
					<Inputs>
						<RelativeTo>{InputDir}</RelativeTo>
						<Path>{CurrentIdentifier}</Path>
					</Inputs>
					<Outputs>
						<Output>RelativeDir</Output>
					</Outputs>
					<Connections>
						<Default>Process_03</Default>
					</Connections>
				</Node>

				<!-- We need to get the set of information for the file that is being processed -->
				<Node Name="Get Video Meta-Data" ID="Process_03" TypeID="GetVideoDetailsNode">
					<Inputs>
						<FFprobe>{FFprobe}</FFprobe>
						<Target>{CurrentIdentifier}</Target>
					</Inputs>
					<Outputs>
						<Output>FileMetaData</Output>
					</Outputs>
					<Connections>
						<Default>Process_04</Default>
					</Connections>
				</Node>

				<!-- We need to find the Handbrake Preset option that will best work with this type of video file -->
				<Node Name="Find Handbrake Preset Best Fit" ID="Process_04" TypeID="FindHandbrakePresetForVideoNode">
					<Inputs>
						<VideoInfo>{FileMetaData}</VideoInfo>
						<HandbrakePresets>{HandbrakePresets}</HandbrakePresets>
					</Inputs>
					<Outputs>
						<Output>TranscodePreset</Output>
					</Outputs>
					<Connections>
						<Default>Process_05</Default>
					</Connections>
				</Node>

				<!-- Process the transcoding of the raw video file into something more usable -->
				<Node Name="Transcode Raw Video" ID="Process_05" TypeID="TranscodeVideoNode">
					<Inputs>
						<Handbrake>{HandbrakeCLI}</Handbrake>
						<VideoPath>{CurrentIdentifier}</VideoPath>
						<Preset>{TranscodePreset}</Preset>
						<OutputDir>{WorkingDir}\{RelativeDir}\Transcode</OutputDir>
						<AllowHardwareAcceleration>{HardwareAcceleration}</AllowHardwareAcceleration>
						<AdditionalProcessArgs>--markers --preset-import-file "{HandbrakeManifestPath}"</AdditionalProcessArgs>
					</Inputs>
					<Outputs>
						<Output>OutputFile</Output>
					</Outputs>
					<Connections>
						<Default>Process_06</Default>
					</Connections>
				</Node>

				<!-- We need to get the set of information for the file that is being processed -->
				<Node Name="Get Video Meta-Data" ID="Process_06" TypeID="GetVideoDetailsNode">
					<Inputs>
						<FFprobe>{FFprobe}</FFprobe>
						<Target>{OutputFile}</Target>
					</Inputs>
					<Outputs>
						<Output>FileMetaData</Output>
					</Outputs>
					<Connections>
						<Default>Process_07</Default>
					</Connections>
				</Node>

				<!-- We need to find all of the subtitle streams that are attached to the video -->
				<Node Name="Select Streams" ID="Process_07" TypeID="ReflectiveSelectNode">
					<Inputs>
						<Source>{FileMetaData}</Source>
						<Path>Streams</Path>
					</Inputs>
					<Outputs>
						<Output>Streams</Output>
					</Outputs>
					<Connections>
						<Default>Process_08</Default>
					</Connections>
				</Node>

				<!-- We can filter all of the subtitle streams down to just those that are image based -->
				<Node Name="Isolate Subtitle Streams" ID="Process_08" TypeID="FilterCollectionNode">
					<Inputs>
						<Collection>{Streams}</Collection>
						<SubValue>SubtitleType</SubValue>
						<Filter>Image</Filter>
					</Inputs>
					<Outputs>
						<Output>SubtitleStreams</Output>
					</Outputs>
					<Connections>
						<Default>Process_09</Default>
					</Connections>
				</Node>

				<!-- We're going to try and convert any image based subtitles that exist -->
				<Node Name="Isolate Graphical Subtitle Streams" ID="Process_09" TypeID="FilterCollectionNode">
					<Inputs>
						<Collection>{Streams}</Collection>
						<SubValue>SubtitleType</SubValue>
						<Filter>Image</Filter>
					</Inputs>
					<Outputs>
						<Output>GraphicSubtitleStreams</Output>
					</Outputs>
					<Connections>
						<Default>Process_10</Default>
					</Connections>
				</Node>

				<!-- Check to see if there are any image based sub-titles, if not, then we don't need to do anything for this file -->
				<Node Name="Count Image Streams" ID="Process_10" TypeID="CountCollectionNode">
					<Inputs>
						<Collection>{GraphicSubtitleStreams}</Collection>
					</Inputs>
					<Outputs>
						<Output>ImageSubtitleCount</Output>
					</Outputs>
					<Connections>
						<Default>Process_11</Default>
					</Connections>
				</Node>

				<!-- If there were no image based subtitle streams, we can be finished with this file and not bother with it again -->
				<Node Name="Check Subtitles Needing Processing" ID="Process_11" TypeID="ComparisonNode">
					<Inputs>
						<LeftValue>{ImageSubtitleCount}</LeftValue>
						<RightValue>0</RightValue>
					</Inputs>
					<Connections>
						<!-- If there are no image based subtitles, we can skip the conversion step -->
						<True>Process_20</True>

						<!-- We will actually need to process the conversion of the subtitles into text -->
						<False>Process_12</False>
					</Connections>
				</Node>

				<!-- We need to extract all of the subtitles to a file that we can process -->
				<Node Name="Extract Subtitles" ID="Process_12" TypeID="ExtractSubtitlesNode">
					<Inputs>
						<FFmpeg>{FFmpeg}</FFmpeg>
						<Source>{OutputFile}</Source>
						<Streams>{SubtitleStreams}</Streams>
						<StorageDir>{WorkingDir}\{RelativeDir}\Subtitles</StorageDir>
					</Inputs>
					<Connections>
						<Default>Process_13</Default>
					</Connections>
				</Node>

				<!-- Now that we have the extracted files, we need to convert them into text files that can be added back to the source file -->
				<Node Name="Convert Graphic Subs to Text" ID="Process_13" TypeID="ConvertGraphicSubsToTextNode">
					<Inputs>
						<SubtitleEdit>{SubtitleEdit}</SubtitleEdit>
						<Streams>{GraphicSubtitleStreams}</Streams>
						<SourceDir>{WorkingDir}\{RelativeDir}\Subtitles</SourceDir>
					</Inputs>
					<Connections>
						<Default>Process_14</Default>
					</Connections>
				</Node>

				<!-- Evaluate the conversion of the subtitles to see if the process was good enough to be used -->
				<Node Name="Check Conversion Success" ID="Process_14" TypeID="EstimateSRTConversionSuccessNode">
					<Inputs>
						<Streams>{GraphicSubtitleStreams}</Streams>
						<SourceDir>{WorkingDir}\{RelativeDir}\Subtitles</SourceDir>
						<DictionaryFile>{Dictionary}</DictionaryFile>
					</Inputs>
					<Outputs>
						<Summary>ConversionSummary</Summary>
					</Outputs>
					<Connections>
						<Default>Process_15</Default>
					</Connections>
				</Node>

				<!-- Save the summary of the conversion to the directory for use -->
				<Node Name="Output Conversion Summary" ID="Process_15" TypeID="JSONSerialiseToDiskNode">
					<Inputs>
						<Value>{ConversionSummary}</Value>
						<OutputPath>{WorkingDir}\{RelativeDir}\Subtitles\Conversion.json</OutputPath>
					</Inputs>
					<Connections>
						<Default>Process_16</Default>
					</Connections>
				</Node>

				<!-- We need the file name isolated for the output process -->
				<Node Name="Isolate Video File Name" ID="Process_16" TypeID="GetFileNameNode">
					<Inputs>
						<FilePath>{CurrentIdentifier}</FilePath>
					</Inputs>
					<Outputs>
						<Output>FileName</Output>
					</Outputs>
					<Connections>
						<Default>Process_17</Default>
					</Connections>
				</Node>

				<!-- We need to remove the subtitle streams from the transcoded video so they don't cause problems down the line -->
				<Node Name="Remove Graphical Subtitle Streams" ID="Process_17" TypeID="RemoveStreamsNode">
					<Inputs>
						<FFmpeg>{FFmpeg}</FFmpeg>
						<Source>{OutputFile}</Source>
						<Streams>{GraphicSubtitleStreams}</Streams>
						<TargetInfo>{FileMetaData}</TargetInfo>
						<OutputPath>{WorkingDir}\{RelativeDir}\Remux\{FileName}</OutputPath>
					</Inputs>
					<Outputs>
						<Output>OutputFile</Output>
					</Outputs>
					<Connections>
						<Default>Process_18</Default>
					</Connections>
				</Node>

				<!-- Get the name of the relative directory so the subtitles will be placed in a folder of the target file name -->
				<Node Name="Get Relative Parent Directory" ID="Process_18" TypeID="GetDirectoryNameNode">
					<Inputs>
						<FilePath>{RelativeDir}</FilePath>
					</Inputs>
					<Outputs>
						<Output>RelativeParentDir</Output>
					</Outputs>
					<Connections>
						<Default>Process_19</Default>
					</Connections>
				</Node>

				<!-- Copy the subtitles extracted to the storage location for later use -->
				<Node Name="Archive Subtitle Directory" ID="Process_19" TypeID="CopyDirectoryNode">
					<Inputs>
						<TargetDir>{WorkingDir}\{RelativeDir}\Subtitles</TargetDir>
						<DestinationPath>{SubtitleDir}\{RelativeParentDir}</DestinationPath>
						<RenameDirectory>{FileName}</RenameDirectory>
					</Inputs>
					<Connections>
						<Default>Process_20</Default>
					</Connections>
				</Node>

				<!-- Copy the remuxed file from the working directory to the final location -->
				<Node Name="Move Final File into Place" ID="Process_20" TypeID="MoveFileNode">
					<Inputs>
						<SourceFileName>{OutputFile}</SourceFileName>
						<DestinationFileName>{OutputDir}\{RelativeDir}</DestinationFileName>
						<Overwrite>True</Overwrite>
					</Inputs>
					<Connections>
						<Default>Process_End</Default>
					</Connections>
				</Node>

				<!-- This can mark off the file in the manifest so that we don't process it again -->
				<Node Name="Mark Off File In Manifest" ID="Process_End" TypeID="SetManifestDataNode">
					<Inputs>
						<ManifestPath>{OutputDir}\TranscodeRawMediaWithSubBackup_Manifest.json</ManifestPath>
						<Identifier>{CurrentIdentifier}</Identifier>
						<Key>State</Key>
						<Value>Complete</Value>
					</Inputs>
				</Node>
			</ProcessGraph>
		</MainGraph>

		<!-- When the graph has finished being processed, we can clean up the working directory that is no longer needed -->
		<PostProcessGraph>
			<!-- Check to see if we finished the process successfully -->
			<Node Name="Were we Successful?" ID="PostProcess_00" TypeID="ComparisonNode">
				<Inputs>
					<LeftValue>{ProcessedSuccessfully}</LeftValue>
					<RightValue>True</RightValue>
				</Inputs>
				<Connections>
					<!-- If we weren't successful, then we can exit now and leave the working directory for troubleshooting -->
					<False></False>

					<!-- If we were, we can clean up the working directory. Don't need it anymore -->
					<True>PostProcess_01</True>
				</Connections>
			</Node>

			<!-- Delete the working directory -->
			<Node Name="Clean up Working Directory" ID="PostProcess_01" TypeID="DeleteDirectoryNode">
				<Inputs>
					<TargetDir>{WorkingDir}</TargetDir>
				</Inputs>
			</Node>
		</PostProcessGraph>
	</Workflow>
</Pipeline>